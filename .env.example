# docker compose が自動読込する変数のサンプル
# このファイルを .env にコピーして値を設定してください (.env はgitignore済み)
#   cp .env.example .env

# rootlessビルド用のuid/gid。ホストのユーザーに合わせる (id -u / id -g)
APP_UID=1000
APP_GID=1000

# UIログインパスワード (本番では必ず変更すること)
AI_TOOLKIT_AUTH=password

# UIのホスト側公開ポート (コンテナ内は8675固定)
AI_TOOLKIT_PORT=8675

# イメージ名 / コンテナ名 (同一ホストで複数立てる場合に変更)
AI_TOOLKIT_IMAGE=aitoolkit-rootless:latest
AI_TOOLKIT_CONTAINER=ai-toolkit-rootless
